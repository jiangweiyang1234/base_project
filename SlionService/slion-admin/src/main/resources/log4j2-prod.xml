<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">
    <Properties>
        <Property name="log.path">./logs</Property>
        <Property name="log.pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${log.pattern}" charset="UTF-8"/>
        </Console>

        <RollingFile name="FileInfo" fileName="${log.path}/sys-info.log"
                     filePattern="${log.path}/sys-info.%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${log.pattern}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="256 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="60"/>
            <Filters>
                <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </RollingFile>

        <RollingFile name="FileError" fileName="${log.path}/sys-error.log"
                     filePattern="${log.path}/sys-error.%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${log.pattern}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="128 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="90"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </RollingFile>

        <RollingFile name="FileConsole" fileName="${log.path}/sys-console.log"
                     filePattern="${log.path}/sys-console.%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${log.pattern}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="256 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="net.slion" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileInfo"/>
            <AppenderRef ref="FileError"/>
        </Logger>
        <!-- AsyncRoot 依赖 disruptor，高流量下异步写盘降低阻塞 -->
        <AsyncRoot level="info" includeLocation="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileInfo"/>
            <AppenderRef ref="FileError"/>
            <AppenderRef ref="FileConsole"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
