IMAGE_TAG=1.0.0
# 含空格的值必须加引号，否则 shell/source 会误解析
JAVA_OPTS="-Xms256m -Xmx512m"

SLION_DB_USER=postgres
SLION_DB_PASSWORD=hxsoft.net
SLION_DB_NAME=slion
SLION_PG_HOST_PORT=5432
SLION_REDIS_HOST_PORT=26379
SLION_REDIS_PASSWORD=slion_redis_pass
SLION_ADMIN_HOST_PORT=28080
SLION_WEB_HOST_PORT=280
SLION_MINIO_API_PORT=9000
SLION_MINIO_CONSOLE_PORT=9001
# MinIO 账号（需与库表 sys_oss_config.minio 的 access_key/secret_key 一致）
MINIO_ROOT_USER=ruoyi
MINIO_ROOT_PASSWORD=ruoyi123
# 桶名（出现在 URL /oss/{bucket}/... 中）
# 注意：改此项不会自动建桶，也不会自动改库表。需同时：
#   1) MinIO 中 mc mb 创建同名桶
#   2) UPDATE sys_oss_config SET bucket_name='slion' WHERE config_key='minio'
#   3) 重启 slion-admin
MINIO_BUCKET=slion
# 浏览器访问前缀写在库表 sys_oss_config.domain，例如 https://slion.hxsoft.net/oss
# （须与 OpenResty location /oss/ 及 server_name 一致）
SLION_KAFKA_HOST_PORT=9092
SLION_JWT_SECRET=CHANGE_ME_JWT_SECRET_PLEASE_OVERRIDE
# 登录等 @ApiEncrypt 接口传输加密（RSA 公钥/私钥 Base64，无 PEM 头尾）
# 真实密钥只写 deploy/.env（已 gitignore），勿把私钥提交进仓库
SLION_API_DECRYPT_ENABLED=true
SLION_API_PUBLIC_KEY=
SLION_API_PRIVATE_KEY=

# 多租户（/system/tenant*）；工作流 warm-flow（/workflow/**）
TENANT_ENABLED=true
WARM_FLOW_ENABLED=true

# OAuth2 开放 API（测试/生产按需开启；issuer 填同域根地址，勿带末尾 /）
# 正式 AppKey/AppSecret 在管理台「系统管理 → 开放应用」配置
OAUTH2_ENABLED=false
OAUTH2_ISSUER=https://test-slion.example.com
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPE=open.api

# 前端构建参数（密钥请配置在SlionWeb/.env.local，不要填 preview）
VUE_APP_BASE_URL=/prod-api
VUE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e

