IMAGE_TAG=1.0.0
# 含空格的值必须加引号，否则 shell/source 会误解析
JAVA_OPTS="-Xms256m -Xmx512m"

SLION_DB_USER=postgres
SLION_DB_PASSWORD=postgres
SLION_DB_NAME=slion
SLION_PG_HOST_PORT=5432
SLION_REDIS_HOST_PORT=26379
SLION_REDIS_PASSWORD=slion_redis_pass
SLION_ADMIN_HOST_PORT=28080
SLION_WEB_HOST_PORT=280
SLION_KAFKA_HOST_PORT=9092
SLION_JWT_SECRET=CHANGE_ME_JWT_SECRET_PLEASE_OVERRIDE
SLION_API_PUBLIC_KEY=
SLION_API_PRIVATE_KEY=

# 前端构建参数（密钥请配置在SlionWeb/.env.local，不要填 preview）
VUE_APP_BASE_URL=/prod-api
VUE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e

